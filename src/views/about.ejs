<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
        <div class="about-container">
        <div class="intro card">
            <div class="card-title"><p>Hello I'm</p></div>
            <h2> Autumn!</h2>
        </div>
        <div class="facts card">
            <p><strong>Major: </strong>Web Design and Development</p>
            <p><strong>Projected Graduation: </strong>April 2026</p>
        </div>
        <div class="profile-pic card">
            <img src="/images/profile.JPG" alt="Autumn">
        </div>
        <div class="about-me card">
            <div class="card-title"><p>About Me</p></div>
            <p>I have a sweet little cat named Hobbes who enjoys watching birds from the kitchen window.</p>
            <p>I am originally from New Hampshire, currently living in Utah, and looking to move back to the East Coast.</p>
        </div>
        <div class="hobbies card">
            <div class="card-title"><p>My Hobbies</p></div>
            <ul class="hobbies-list">
                <li>Junk journaling</li>
                <li>Crocheting</li>
                <li>Any kind of craft in general</li>
                <li>Organizing</li>
                <li>Cuddling Hobbes the cat</li>
            </ul>
        </div>
        <div class="pet card">
            <div class="card-title"><p>Hobbes</p></div>
            <img src="/images/pet.jpg" alt="Hobbes">
        </div>
    </div>
    <p class="art-source">Inspiration: <a class="art-source" href="https://www.canva.com/templates/EAGVIZcwJmY-colorful-modern-personal-profile-all-about-me-poster/">Canva template</a> by user NassyArt.</p> 
</main>
<%- include('partials/footer') %>